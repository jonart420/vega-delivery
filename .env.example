# VEGA Delivery – configuration. Copy to .env and fill in, or run ./scripts/generate-env.sh.
# .env is never committed. Secrets belong here only – never in the database or the UI.
#
# SECURITY: in production (APP_ENV=production, the default in Docker) the backend stays LOCKED
# while any secret below still contains a "change-me" value or is too weak (passwords < 16
# characters, secrets < 32 bytes). Every page then explains what to fix.

# ── Environment ──────────────────────────────────────
# production | development (development disables the secret check – never use it on a server)
APP_ENV=production
# Public URL of this installation (tracking links, e-mails, app login QR codes)
PUBLIC_BASE_URL=https://delivery.example.com
# Behind HTTPS set to true
COOKIE_SECURE=true
TZ=Europe/Berlin
# UI default language: en | de
DEFAULT_LOCALE=en
# Default country prefix for phone numbers written with a leading 0
DEFAULT_PHONE_PREFIX=+49

# ── Database ─────────────────────────────────────────
POSTGRES_DB=vega
POSTGRES_USER=vega
POSTGRES_PASSWORD=change-me-postgres-password
DB_PORT=5433

# ── Back office ──────────────────────────────────────
BACKEND_PORT=3100
# 127.0.0.1 = only this machine (put a reverse proxy in front); 0.0.0.0 = whole network
BACKEND_BIND=127.0.0.1
# First admin (only created while no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
# Secret for the drivers' login codes (min. 32 bytes): openssl rand -base64 48
# Changing it invalidates all login codes.
LOGIN_CODE_SECRET=change-me-login-code-secret-at-least-32-bytes

# ── Branding ─────────────────────────────────────────
BRAND_NAME=VEGA Delivery
BRAND_COLOR=#2563eb
# Logo files live in ./branding (mounted into the container), see branding/README.md
# BRANDING_MOUNT=./branding

# ── Maps ─────────────────────────────────────────────
# osm    = free OpenStreetMap vector map (OpenFreeMap) or your own style via MAP_STYLE_URL
# mapbox = Mapbox style (needs a public pk.* token); used by back office, tracking page and apps
MAP_PROVIDER=osm
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# MAPBOX_ACCESS_TOKEN=pk.change-me
# MAPBOX_STYLE=mapbox/streets-v12
# Initial map centre of the web UI before data exists ("lon,lat"; build-time variable)
# NEXT_PUBLIC_MAP_CENTER=10.0,53.55

# ── Routing (Valhalla) ───────────────────────────────
# OSM extracts from https://download.geofabrik.de (space separated). Examples:
#   one city:     https://download.geofabrik.de/europe/germany/hamburg-latest.osm.pbf
#   a country:    https://download.geofabrik.de/europe/germany-latest.osm.pbf
#   worldwide:    https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf  (needs > 64 GB RAM, ~1 TB disk)
VALHALLA_TILE_URLS=https://download.geofabrik.de/europe/germany/hamburg-latest.osm.pbf
VALHALLA_THREADS=4
VALHALLA_PORT=8002
# Force a rebuild once (or use scripts/valhalla-update.sh)
# VALHALLA_FORCE_REBUILD=False

# ── Place search (Photon geocoder) ───────────────────
# Default: public instance of komoot (fair use). Own instance e.g. http://photon:2322
# GEOCODER_URL=https://photon.komoot.io
# Limit results to a region: minLon,minLat,maxLon,maxLat
# GEOCODER_BBOX=8.4,53.3,10.4,54.0

# ── E-mail (SMTP) ────────────────────────────────────
# Empty SMTP_HOST disables e-mail. Dev: docker compose --profile dev up -d, SMTP_HOST=mailpit, SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VEGA Delivery <delivery@example.com>

# ── WhatsApp ─────────────────────────────────────────
# none | log (print to server log) | meta (WhatsApp Cloud API) | twilio
WHATSAPP_PROVIDER=none
# Meta WhatsApp Cloud API
# WHATSAPP_META_TOKEN=change-me
# WHATSAPP_META_PHONE_NUMBER_ID=change-me
# Approved template names per message kind (variables: 1 = name, 2 = ETA, 3 = tracking link)
# WHATSAPP_META_TEMPLATE_DAY_START=delivery_today
# WHATSAPP_META_TEMPLATE_APPROACHING=delivery_approaching
# WHATSAPP_META_TEMPLATE_MANUAL=delivery_update
# WHATSAPP_META_TEMPLATE_DELIVERED=delivery_done
# WHATSAPP_META_TEMPLATE_FAILED=delivery_failed
# Twilio
# TWILIO_ACCOUNT_SID=change-me
# TWILIO_AUTH_TOKEN=change-me
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_CONTENT_SID_APPROACHING=HX…

# Notification worker (ms) – sends queued messages, moves the "3 stops ahead" window
# NOTIFY_WORKER_INTERVAL_MS=30000

# ── Storage (Linux servers: absolute paths instead of Docker volumes) ──
# PGDATA_MOUNT=/srv/vega/pgdata
# VALHALLA_MOUNT=/srv/vega/valhalla
# UPLOADS_MOUNT=/srv/vega/uploads
# BACKUP_DIR=./backups

# ── Local development without Docker (npm run dev in backend/) ──
# DATABASE_URL=postgres://vega:password@localhost:5433/vega
# VALHALLA_URL=http://localhost:8002
